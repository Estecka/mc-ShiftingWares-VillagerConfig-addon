	"description": "Compatibility addon for ShiftingWares and VillagerConfig",
	"authors": [
		"Estecka"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/shiftingwares-villagerconfig-addon",
		"sources": "https://github.com/Estecka/mc-ShiftingWares-VillagerConfig-addon",
		"issues":  "https://github.com/Estecka/mc-ShiftingWares-VillagerConfig-addon/issues"
	},
	"license": "MIT",
	"icon": "assets/shifting-wares/villagerconfig-addon.png",
